# --- Required ---
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_ACCESS_SECRET=change-me-please-use-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-different-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Public URL of THIS API (used in verification emails, CORS logs)
API_PUBLIC_URL=https://your-api.example.com

# Origin of the Lovable frontend (CORS + email deep-links). Comma-separate if multiple.
FRONTEND_ORIGIN=https://your-site.lovable.app,http://localhost:8080

# Cookie domain for the refresh-token cookie (leave blank for host-only)
COOKIE_DOMAIN=
COOKIE_SECURE=true

# --- SMTP (for email verification / OTP / password reset) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxx
SMTP_FROM="CodeNest Solutions <noreply@yourdomain.com>"

# --- Optional ---
PORT=4000
NODE_ENV=production

# --- Lead notifications (website enquiry form) ---
# Internal inbox that receives new client account approvals.
APPROVAL_EMAIL=netweavesolutions.co@gmail.com
# Inbox that receives new project enquiries. Defaults to APPROVAL_EMAIL if unset.
LEAD_NOTIFY_EMAIL=netweavesolutions.co@gmail.com

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers → your app → WhatsApp → API Setup.
# All four are required for WhatsApp alerts; leave blank to disable them
# (email notifications keep working either way).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Recipients in E.164 without '+'. Comma-separate for multiple numbers.
WHATSAPP_TO=918434554873
# Name of the approved message template used for the alert.
WHATSAPP_TEMPLATE_NAME=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# Set to true to send plain text instead of a template. Only works if the
# recipient messaged your business number in the last 24 hours.
WHATSAPP_USE_TEXT=false

