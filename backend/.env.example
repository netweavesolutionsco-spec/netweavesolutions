# --- Required ---
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_ACCESS_SECRET=change-me-please-use-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-different-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Public URL of THIS API (Render service URL). Used in CORS logs.
API_PUBLIC_URL=https://netweavesolutions.onrender.com

# CORS allow-list of frontend origins. Comma-separate if multiple. This may
# contain localhost and staging origins — it is NOT used to build email links.
FRONTEND_ORIGIN=https://netweavesolutions.tech,http://localhost:8080

# Canonical public site URL used to build deep links inside verification /
# password-reset emails. This MUST be the live client site (never an API or
# localhost origin) because it is the URL the user actually clicks. Falls back
# to the first FRONTEND_ORIGIN entry if unset — set it explicitly in production.
# The paths /client/verify-email, /client/reset-password and
# /client/oauth-callback are appended to this value, so all three must be in the
# Supabase Auth "Redirect URLs" allow-list (see below).
SITE_URL=https://netweavesolutions.tech

# Cookie domain for the refresh-token cookie (leave blank for host-only)
COOKIE_DOMAIN=
COOKIE_SECURE=true

# --- SMTP (REQUIRED for email verification / OTP / password reset) ---
# Without SMTP_HOST the backend cannot deliver branded verification emails and
# falls back to Supabase's own mailer (which must then be configured in the
# Supabase dashboard, and is subject to Supabase's low rate limits). Set these
# in production so account-verification email is reliable.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxx
SMTP_FROM="Netweavesolutions <noreply@netweavesolutions.tech>"

# --- Optional ---
PORT=4000
NODE_ENV=production

# --- Lead notifications (website enquiry form) ---
# Internal inbox that receives new client account approvals.
APPROVAL_EMAIL=netweavesolutions.co@gmail.com
# Inbox that receives new project enquiries. Defaults to APPROVAL_EMAIL if unset.
LEAD_NOTIFY_EMAIL=netweavesolutions.co@gmail.com

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers → your app → WhatsApp → API Setup.
# All four are required for WhatsApp alerts; leave blank to disable them
# (email notifications keep working either way).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Recipients in E.164 without '+'. Comma-separate for multiple numbers.
WHATSAPP_TO=918434554873
# Name of the approved message template used for the alert.
WHATSAPP_TEMPLATE_NAME=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# Set to true to send plain text instead of a template. Only works if the
# recipient messaged your business number in the last 24 hours.
WHATSAPP_USE_TEXT=false
# Approved Meta "authentication" template for delivering the mobile OTP to a
# client's own number. Leave unset to disable WhatsApp OTP delivery — the code
# is then emailed to the (already verified) address instead.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en

